# BlockScore Web Frontend Environment Variables

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_TIMEOUT=10000

# Blockchain Configuration
REACT_APP_NETWORK_ID=1
REACT_APP_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Address of the deployed LoanContractV2 (see
# code/blockchain/scripts/deploy.js output, or
# code/blockchain/deployments/<network>/addresses.json). Loan applications
# are submitted directly to this contract by the connected wallet - see
# src/utils/onChainLoanApplication.js. Leave unset to hide the "Submit
# On-Chain" option in the Loan Calculator.
REACT_APP_LOAN_CONTRACT_V2_ADDRESS=

# Feature Flags
REACT_APP_ENABLE_DEBUG=false
REACT_APP_ENABLE_MOCK_DATA=true

# Analytics (Optional)
REACT_APP_ANALYTICS_ID=

# App Configuration
REACT_APP_NAME=BlockScore
REACT_APP_VERSION=1.0.0
